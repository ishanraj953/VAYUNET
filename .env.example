# ====================================================================
# VayuNet India - Sovereign Air Quality & Health Risk Platform
# Environment Variables & Deployment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. FASTAPI BACKEND CONFIGURATION (For Render / Railway / Local)
# --------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# JWT Authentication Secret Key
JWT_SECRET=vayunet_super_secret_jwt_key_2026_production

# MongoDB Atlas URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.6c3ws3t.mongodb.net/vayunet?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=vayunet

# Optional OpenAQ v3 API Key for direct CAAQMS live feed
OPENAQ_API_KEY=your_openaq_v3_api_key_here

# --------------------------------------------------------------------
# 2. REACT FRONTEND CONFIGURATION (frontend/.env for Vercel / Local)
# --------------------------------------------------------------------
# Base URL for API endpoints (e.g., http://127.0.0.1:8000/api or https://vayunet.onrender.com/api)
VITE_API_URL=http://127.0.0.1:8000/api
