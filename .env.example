# ====================================================================
# VayuNet India - Sovereign Air Quality & Health Risk Platform
# Environment Variables & Deployment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. FASTAPI BACKEND CONFIGURATION (For Render / Railway / Local)
# --------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# JWT Authentication Secret Key
JWT_SECRET=vayunet_super_secret_jwt_key_2026_production

# MongoDB Atlas URI & Database Name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.6c3ws3t.mongodb.net/vayunet?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=vayunet

# Optional OpenAQ v3 API Key for direct CAAQMS live feed
OPENAQ_API_KEY=your_openaq_v3_api_key_here

# Optional Google OAuth 2.0 Credentials (for backend token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --------------------------------------------------------------------
# 2. REACT FRONTEND CONFIGURATION (frontend/.env for Vercel / Local)
# --------------------------------------------------------------------
# Base URL for API endpoints (Use your Render backend URL in production)
VITE_API_URL=http://127.0.0.1:8000/api

# Firebase Web Application Credentials
# (From Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=AIzaSyC5mbf4Ge2REvh1T4gex2y1B9e7rfBm1VA
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475610
VITE_FIREBASE_APP_ID=1:102938475610:web:9a8b7c6d5e4f3a2b1c
